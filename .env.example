# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
#
# Every variable the code reads is prefixed COPILOT_ (see backend/src/copilot/
# config.py, `env_prefix="COPILOT_"`). An unprefixed name here is inert: this file
# previously listed ANTHROPIC_API_KEY, APIFY_TOKEN, JA_DB_PATH and LOCAL_DB, none
# of which any v2 code reads — so following it produced a run on config defaults
# and no error at all. JA_DB_PATH also pointed at one developer's home directory,
# in a public repo, at a database that is gone.

# --- what runs with no configuration at all ----------------------------------
# Job supply is keyless: Greenhouse, Ashby, Lever, Workable and Workday are public
# unauthenticated APIs, the gates are regex, and the posting store defaults to
# SQLite at data/postings.db. The daily run works with this file absent.

# --- storage ------------------------------------------------------------------
# Empty (the default) means "use SQLite at COPILOT_POSTINGS_DB_PATH". Setting a
# table name is the only switch to DynamoDB, so the two can never disagree.
# COPILOT_POSTINGS_TABLE_NAME=career-copilot-postings
# COPILOT_TABLE_NAME=career-copilot
# COPILOT_AWS_REGION=us-east-1
# COPILOT_POSTINGS_DB_PATH=data/postings.db

# --- identity -----------------------------------------------------------------
# Where the daily digest is emailed. Blank = do not email (not an error).
# COPILOT_MY_EMAIL=you@example.com
# Cognito `sub` the briefing is stored under. Blank stores it under "", which no
# authenticated read can match, so GET /briefing 404s forever with nothing logged.
# COPILOT_OWNER_USER_ID=

# --- optional LLM paths (both degrade to "no result" when unset) ---------------
# Reply drafting. Unset => no drafts; the run still completes.
# COPILOT_LLM_API_KEY=
# The level interpreter, for the eligible postings whose title carries no level
# marker. Unset => interpret() returns None and the rule verdict stands.
# COPILOT_INTERPRETER_API_KEY=

# --- secret ids (cloud only; the runtime fetch is NOT implemented yet) ---------
# COPILOT_GMAIL_SECRET_ID=career-copilot/gmail
# COPILOT_INTERPRETER_SECRET_ID=/career-copilot/interpreter-api-key
# COPILOT_LLM_SECRET_ID=/career-copilot/llm-api-key

# --- private content (gitignored; see private.example/) -----------------------
# Résumé, tailoring prompts and answer library. Absent => scoring reports itself
# unavailable rather than scoring everything zero.
# COPILOT_PRIVATE_DIR=private

# Gmail OAuth is not stored here. It lives in credentials.json + token.json (both
# git-ignored) locally, and in Secrets Manager under COPILOT_GMAIL_SECRET_ID in the
# cloud — where nothing reads it yet, so the inbox half is skipped and the run
# reports `inbox_ok: false`.
